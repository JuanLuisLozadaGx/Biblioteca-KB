				RegionName

				[

					Type = 'VarChar',

					Length = '40'

				]

			}

		}

		

		ClearRegions

		[

			IsStatic = 'True',

			AndroidExternalName = 'clearRegions'

		]

		

		GetRegionStatus

		[

			Type = 'MapRegion, GeneXus.SD',

			Length = '0',

			IsStatic = 'True',

			AndroidExternalName = 'getRegionStatus'

		]

		{

			Parameters

			{

				RegionName

				[

					Type = 'VarChar',

					Length = '40'

				]

			}

		}

		

		CancelRegionDownload

		[

			IsStatic = 'True',

