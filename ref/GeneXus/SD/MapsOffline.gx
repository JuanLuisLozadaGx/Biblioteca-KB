ExternalObject MapsOffline
{
	#ExternalProperties
		IsOfflineGeographicDataSupported

		[

			PropertyType = 'Read',

			Type = 'Boolean',

			Length = '4',

			IsStatic = 'True',

			AndroidExternalName = 'isOfflineGeographicDataSupported',

			AndroidExternalGetMethod = 'isOfflineGeographicDataSupported'

		]

		

		DownloadedRegions

		[

			PropertyType = 'Read',

			Type = 'VarChar',

			Length = '40',

			Collection = 'True',

			IsStatic = 'True',

			AndroidExternalName = 'getDownloadedRegions',

			AndroidExternalGetMethod = 'getDownloadedRegions'

		]

		

		Size

		[

			PropertyType = 'Read',

			Type = 'Numeric',

			Length = '9',

			IsStatic = 'True',

			AndroidExternalGetMethod = 'getSize'

		]

		

		
	#End

	#ExternalMethods
		DownloadRegion

		[

			Type = 'Boolean',

			Length = '4',

			IsStatic = 'True',

			AndroidExternalName = 'downloadRegion'

		]

		{

			Parameters

			{

				RegionName

				[

					Type = 'VarChar',

					Length = '40'

				]

		

				NorthEast

				[

					Type = 'GeoPoint',

					Length = '255'

				]

		

				SouthWest

				[

					Type = 'GeoPoint',

					Length = '255'

				]

		

