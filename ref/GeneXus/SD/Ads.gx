ExternalObject Ads
{
	#ExternalMethods
		RequestInterstitial

		[

			IsStatic = 'True',

			IosExternalName = 'requestInterstitial',

			AndroidExternalName = 'requestInterstitial'

		]

		{

			Parameters

			{

				adUnitID

				[

					AccessType = 'In',

					Type = 'VarChar',

					Length = '40',

