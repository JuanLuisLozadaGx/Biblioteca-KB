			JavaExternalName = 'externalName',

			JavaExternalType = 'String',

			JavaExternalSetMethod = 'setExternalName',

			JavaExternalGetMethod = 'getExternalName'

		]

		

		PackageName

		[

			Type = 'VarChar',

			Length = '40',

			JavaExternalName = 'packageName',

			JavaExternalType = 'String',

			JavaExternalSetMethod = 'setPackageName',

			JavaExternalGetMethod = 'getPackageName'

		]

		

		
	#End

	#Properties
		Name = "DynamicCallPropertiesJava"

