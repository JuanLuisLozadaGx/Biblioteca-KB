WebPanel ViewGenre
{
	#Rules
		parm(in:&GenreId, in:&TabCode);
		
	#End

	#Events
		Event Start
		
			If not IsAuthorized(&PgmName)
				NotAuthorized(&PgmName)
			Endif
		
			For each
				Where GenreId = &GenreId
				Form.Caption = GenreName.ToString()
				ViewAll.Link = WWGenre.Link()
				&Exists = True
		
			When none
				Form.Caption = "Record not found"
				ViewAll.Visible = false
				&Exists = False
			Endfor
			&LoadAllTabs = false
		
			If &Exists
				&SelectedTabCode = &TabCode
				Tab.ActivePageControlName = &SelectedTabCode
				Do 'Load Tab'
			Endif
		EndEvent
		
		Event Tab.TabChanged
			&SelectedTabCode = Tab.ActivePageControlName
			&LoadAllTabs = false
			Do 'Load Tab'
		EndEvent
		
		Sub 'Load Tab'
			if &LoadAllTabs or &SelectedTabCode = '' or&SelectedTabCode = "General"
				GeneralWC.Object = GenreGeneral.Create(&GenreId)
			endif
			if &LoadAllTabs or &SelectedTabCode = "Book"
				BookWC.Object = GenreBookWC.Create(&GenreId)
			endif
		EndSub
		
	#End

	#Conditions
		GenreId = &GenreId;
		
	#End

	#Variables
		IsAuthorized [ DataType = 'Boolean' ]

		TabCode [ DataType = 'TabCode, General' ]

		SelectedTabCode [ DataType = 'TabCode, General' ]

		Tabs

		Tab

		Exists [ Description = 'Exists', DataType = 'Boolean' ]

		LoadAllTabs [ Description = 'LoadAllTabs', DataType = 'Boolean' ]

		GenreId [ DataType = 'Attribute:GenreId' ]

		
	#End

	#Properties
		Name = "ViewGenre"

		IsDefault = "False"

		

		WebForm.Defaults = "WorkWith:Templates\\ViewWebForm.dkt"

		

		Rules.Defaults = "WorkWith:Templates\\ViewRules.dkt"

		

		Events.Defaults = "WorkWith:Templates\\ViewEvents.dkt"

		

		Conditions.Defaults = "WorkWith:Templates\\ViewConditions.dkt"

		

		Variables.Defaults = "WorkWith:Templates\\ViewVariables.dkt"

		
	#End

}
