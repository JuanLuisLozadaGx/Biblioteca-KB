<layout type="Web">
	<view>
		<responsive name="Main" class="ContainerFluid PromptContainer">
			<row>
				<cell class="PromptAdvancedBarCell" widthSm="25">
					<responsive name="AdvancedContainer" class="AdvancedContainerVisible">
						<row>
							<cell widthSm="100">
								<responsive name="BookIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblBookIdFilter" caption="=BookId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cBookId" name="ctlcBookId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="BookTitleFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblBookTitleFilter" caption="=BookTitle.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cBookTitle" name="ctlcBookTitle" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="AuthorIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblAuthorIdFilter" caption="=AuthorId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cAuthorId" name="ctlcAuthorId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="PublisherIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblPublisherIdFilter" caption="=PublisherId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cPublisherId" name="ctlcPublisherId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="GenreIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblGenreIdFilter" caption="=GenreId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cGenreId" name="ctlcGenreId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="ShelfIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblShelfIdFilter" caption="=ShelfId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cShelfId" name="ctlcShelfId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="BookISBNFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblBookISBNFilter" caption="=BookISBN.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cBookISBN" name="ctlcBookISBN" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
					</responsive>
				</cell>
				<cell class="WWGridCell" widthSm="75">
					<responsive name="GridTable">
						<row>
							<cell class="ToggleCell" visibleSm="False" widthXs="100" visibleMd="False" visibleLg="False">
								<action name="BtnToggle" onClickEvent="'Toggle'" caption="|||" class="BtnToggle" />
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<tabularGrid name="Grid1" class="PromptGrid" maxRows="10">
									<input title="" class="SelectionAttribute" columnClass="WWActionColumn" returnOnClick="True" data="&amp;LinkSelection" name="ctlLinkSelection" />
									<input title="=BookId.ContextualTitle" columnClass="WWColumn" data="BookId" name="ctlBookId" />
									<input title="=BookTitle.ContextualTitle" class="DescriptionAttribute" columnClass="WWColumn" returnOnClick="True" readOnly="True" data="BookTitle" name="ctlBookTitle" />
									<input title="=AuthorId.ColumnTitle" columnClass="WWColumn OptionalColumn" data="AuthorId" name="ctlAuthorId" />
								</tabularGrid>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<action name="btn_cancel" onClickEvent="Cancel" caption="GX_BtnCancel" class="BtnCancel" />
							</cell>
						</row>
					</responsive>
				</cell>
			</row>
		</responsive>
	</view>
</layout>