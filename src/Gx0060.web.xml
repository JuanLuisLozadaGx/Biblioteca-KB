<layout type="Web">
	<view>
		<responsive name="Main" class="ContainerFluid PromptContainer">
			<row>
				<cell class="PromptAdvancedBarCell" widthSm="25">
					<responsive name="AdvancedContainer" class="AdvancedContainerVisible">
						<row>
							<cell widthSm="100">
								<responsive name="ShelfIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblShelfIdFilter" caption="=ShelfId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cShelfId" name="ctlcShelfId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="ShelfNameFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblShelfNameFilter" caption="=ShelfName.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cShelfName" name="ctlcShelfName" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
					</responsive>
				</cell>
				<cell class="WWGridCell" widthSm="75">
					<responsive name="GridTable">
						<row>
							<cell class="ToggleCell" visibleSm="False" widthXs="100" visibleMd="False" visibleLg="False">
								<action name="BtnToggle" onClickEvent="'Toggle'" caption="|||" class="BtnToggle" />
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<tabularGrid name="Grid1" class="PromptGrid" maxRows="10">
									<input title="" class="SelectionAttribute" columnClass="WWActionColumn" returnOnClick="True" data="&amp;LinkSelection" name="ctlLinkSelection" />
									<input title="=ShelfId.ContextualTitle" columnClass="WWColumn" data="ShelfId" name="ctlShelfId" />
									<input title="=ShelfName.ContextualTitle" class="DescriptionAttribute" columnClass="WWColumn" returnOnClick="True" readOnly="True" data="ShelfName" name="ctlShelfName" />
								</tabularGrid>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<action name="btn_cancel" onClickEvent="Cancel" caption="GX_BtnCancel" class="BtnCancel" />
							</cell>
						</row>
					</responsive>
				</cell>
			</row>
		</responsive>
	</view>
</layout>