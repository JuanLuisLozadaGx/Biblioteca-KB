<layout type="Web">
	<view>
		<responsive name="MainTable" class="body-container">
			<row>
				<cell name="GridCell" class="ww__grid-cell" widthSm="100">
					<responsive name="GridTable" class="container-fluid container-advanced" responsiveSizes="[]">
						<row>
							<cell>
								<flex name="TableTop" class="Flex ww__actions-container">
									<cell class="ww__title-cell" flexGrow="1">
										<label name="TitleText" caption="Loans" class="heading-01" />
									</cell>
									<cell class="ww__actions-cell" flexGrow="0">
										<actiongroup name="Actions" />
									</cell>
									<cell class="ww__filter-cell" flexGrow="0">
										<input labelPosition="None" class="attribute-search" inviteMessage="Person Name" data="&amp;LoanPersonName" name="ctlLoanPersonName" />
									</cell>
								</flex>
							</cell>
						</row>
						<row>
							<cell>
								<errorviewer name="ErrorViewer" />
							</cell>
						</row>
						<row>
							<cell>
								<responsive name="GridContainer" class="ww__grid-container" responsiveSizes="[]">
									<row>
										<cell>
											<tabularGrid name="Grid" class="ww__grid" order="LoanPersonName" maxRows="10" infiniteScrolling="One page at a time">
												<input title="Id" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="LoanId" name="ctlLoanId" />
												<input title="Book Id" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="BookId" name="ctlBookId" />
												<input title="Book Title" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="BookTitle" name="ctlBookTitle" />
												<input title="Person Name" class="attribute-description" inputType="Values" dataSourceFrom="Values" columnClass="column" visible="True" data="LoanPersonName" name="ctlLoanPersonName" />
												<input title="Date" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="LoanDate" name="ctlLoanDate" />
												<input title="Return Date" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="LoanExpectedReturnDate" name="ctlLoanExpectedReturnDate" />
												<input title="Returned Date" inputType="Values" dataSourceFrom="Values" columnClass="column column-optional" visible="True" data="LoanReturnedDate" name="ctlLoanReturnedDate" />
												<input title="" class="TextActionAttribute TextLikeLink" columnClass="WWTextActionColumn" readOnly="True" data="&amp;Update" name="ctlUpdate" />
												<input title="" class="TextActionAttribute TextLikeLink" columnClass="WWTextActionColumn" readOnly="True" data="&amp;Delete" name="ctlDelete" />
											</tabularGrid>
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
					</responsive>
				</cell>
			</row>
		</responsive>
		<actiongroups>
			<actiongroup name="Actions">
				<item>
					<action name="BtnInsert" onClickEvent="'DoInsert'" caption="GXM_insert" class="Button button-primary" />
				</item>
			</actiongroup>
		</actiongroups>
	</view>
</layout>