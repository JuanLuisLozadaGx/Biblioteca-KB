Transaction Book
{
	BookId* [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	BookTitle! [ DataType = 'Title, GeneXusUnanimo' ]

	AuthorId [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	AuthorName [ DataType = 'VarChar(80)' ]

	PublisherId [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	PublisherName

	GenreId [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	GenreName

	ShelfId [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	ShelfName

	BookISBN [ DataType = 'ISBN' ]

	BookPublicationYear [ DataType = 'Numeric(4.0)' ]

	BookPages [ DataType = 'Numeric(5.0)' ]

	BookLanguage [ DataType = 'VarChar(30)' ]

	BookStatus [ DataType = 'ReadingStatus' ]

	BookRating [ DataType = 'Numeric(2.0)' ]

	BookAcquisitionDate [ DataType = 'Date' ]

	BookNotes [ DataType = 'VarChar(256)' ]

	

	#Rules
		/* Generated by Work With Pattern [Start] - Do not change */
		[web]
		{
		parm(in:&Mode, in:&BookId);
		
		BookId = &BookId if not &BookId.IsEmpty();
		noaccept(BookId);
		noprompt(BookId);
		
		AuthorId = &Insert_AuthorId if &Mode = TrnMode.Insert and not &Insert_AuthorId.IsEmpty();
		noaccept(AuthorId) if &Mode = TrnMode.Insert and not &Insert_AuthorId.IsEmpty();
		PublisherId = &Insert_PublisherId if &Mode = TrnMode.Insert and not &Insert_PublisherId.IsEmpty();
		noaccept(PublisherId) if &Mode = TrnMode.Insert and not &Insert_PublisherId.IsEmpty();
		GenreId = &Insert_GenreId if &Mode = TrnMode.Insert and not &Insert_GenreId.IsEmpty();
		noaccept(GenreId) if &Mode = TrnMode.Insert and not &Insert_GenreId.IsEmpty();
		ShelfId = &Insert_ShelfId if &Mode = TrnMode.Insert and not &Insert_ShelfId.IsEmpty();
		noaccept(ShelfId) if &Mode = TrnMode.Insert and not &Insert_ShelfId.IsEmpty();}
		/* Generated by Work With Pattern [End] - Do not change */
		Default(BookStatus, ReadingStatus.Pending);
		Default(BookAcquisitionDate, Today());
		Error(!"La calificación debe estar entre 0 y 5") IF BookRating < 0 OR BookRating > 5;
		
	#End

	#Events
		Event Start
			/* Generated by Work With Pattern [Start] - Do not change */
			[web]
			{
			If not IsAuthorized(&PgmName)
				NotAuthorized(&PgmName)
			Endif
			
			&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
			&Insert_AuthorId.SetEmpty()
			&Insert_PublisherId.SetEmpty()
			&Insert_GenreId.SetEmpty()
			&Insert_ShelfId.SetEmpty()
			
			If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
				For &TrnContextAtt in &TrnContext.Attributes
					Do Case
						// When inserting with instantiated AuthorId
						Case &TrnContextAtt.AttributeName = !"AuthorId"
							&Insert_AuthorId.FromString(&TrnContextAtt.AttributeValue)
						// When inserting with instantiated PublisherId
						Case &TrnContextAtt.AttributeName = !"PublisherId"
							&Insert_PublisherId.FromString(&TrnContextAtt.AttributeValue)
						// When inserting with instantiated GenreId
						Case &TrnContextAtt.AttributeName = !"GenreId"
							&Insert_GenreId.FromString(&TrnContextAtt.AttributeValue)
						// When inserting with instantiated ShelfId
						Case &TrnContextAtt.AttributeName = !"ShelfId"
							&Insert_ShelfId.FromString(&TrnContextAtt.AttributeValue)
					Endcase
				Endfor
			Endif
			
			If &Mode = TrnMode.Delete
				btn_Enter.Caption = "GX_BtnDelete"
				btn_Enter.TooltipText = "GX_BtnDelete"
			EndIf
			}
			/* Generated by Work With Pattern [End] - Do not change */
		EndEvent
		
		Event After Trn
			/* Generated by Work With Pattern [Start] - Do not change */
			[web]
			{
			If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
				WWBook()
			Endif
			
			Return
			}
			/* Generated by Work With Pattern [End] - Do not change */
		EndEvent
		
		
	#End

	#Variables
		BookId [ DataType = 'Attribute:BookId' ]

		IsAuthorized [ DataType = 'Boolean' ]

		TrnContext [ DataType = 'TransactionContext, General.UI' ]

		WebSession [ DataType = 'WebSession' ]

		Insert_AuthorId [ DataType = 'Attribute:AuthorId' ]

		Insert_PublisherId [ DataType = 'Attribute:PublisherId' ]

		Insert_GenreId [ DataType = 'Attribute:GenreId' ]

		Insert_ShelfId [ DataType = 'Attribute:ShelfId' ]

		TrnContextAtt [ DataType = 'TransactionContext.Attribute, General.UI' ]

		
	#End

	#Properties
		Name = "Book"

		ApplyWorkWithForWebPatternOnSave = "True"

		IsDefault = "False"

		

		WebForm.Defaults = "gx:TrnDefaultWebForm.dkt"

		
	#End

}
