Transaction Loan
{
	LoanId* [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	BookId [ DataType = 'Numeric(10.0)', Autonumber = 'True' ]

	BookTitle [ DataType = 'Title, GeneXusUnanimo' ]

	LoanPersonName [ DataType = 'VarChar(64)' ]

	LoanDate [ DataType = 'Date' ]

	LoanExpectedReturnDate [ DataType = 'Date' ]

	LoanReturnedDate [ DataType = 'Date' ]

	

	#Rules
		/* Generated by Work With Pattern [Start] - Do not change */
		[web]
		{
		parm(in:&Mode, in:&LoanId);
		
		LoanId = &LoanId if not &LoanId.IsEmpty();
		noaccept(LoanId);
		noprompt(LoanId);
		
		BookId = &Insert_BookId if &Mode = TrnMode.Insert and not &Insert_BookId.IsEmpty();
		noaccept(BookId) if &Mode = TrnMode.Insert and not &Insert_BookId.IsEmpty();}
		/* Generated by Work With Pattern [End] - Do not change */
		Default(LoanDate, Today());
		Error(!"La fecha estimada de devolución no puede ser anterior a la fecha de préstamo") IF LoanExpectedReturnDate < LoanDate;
		Error(!"La fecha de devolución no puede ser anterior a la fecha de préstamo") IF LoanReturnedDate < LoanDate;
		
	#End

	#Events
		Event Start
			/* Generated by Work With Pattern [Start] - Do not change */
			[web]
			{
			If not IsAuthorized(&PgmName)
				NotAuthorized(&PgmName)
			Endif
			
			&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
			&Insert_BookId.SetEmpty()
			
			If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
				For &TrnContextAtt in &TrnContext.Attributes
					Do Case
						// When inserting with instantiated BookId
						Case &TrnContextAtt.AttributeName = !"BookId"
							&Insert_BookId.FromString(&TrnContextAtt.AttributeValue)
					Endcase
				Endfor
			Endif
			
			If &Mode = TrnMode.Delete
				btn_Enter.Caption = "GX_BtnDelete"
				btn_Enter.TooltipText = "GX_BtnDelete"
			EndIf
			}
			/* Generated by Work With Pattern [End] - Do not change */
		EndEvent
		
		Event After Trn
			/* Generated by Work With Pattern [Start] - Do not change */
			[web]
			{
			If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
				WWLoan()
			Endif
			
			Return
			}
			/* Generated by Work With Pattern [End] - Do not change */
		EndEvent
		
		
	#End

	#Variables
		LoanId [ DataType = 'Attribute:LoanId' ]

		IsAuthorized [ DataType = 'Boolean' ]

		TrnContext [ DataType = 'TransactionContext, General.UI' ]

		WebSession [ DataType = 'WebSession' ]

		Insert_BookId [ DataType = 'Attribute:BookId' ]

		TrnContextAtt [ DataType = 'TransactionContext.Attribute, General.UI' ]

		
	#End

	#Properties
		Name = "Loan"

		ApplyWorkWithForWebPatternOnSave = "True"

		IsDefault = "False"

		

		WebForm.Defaults = "gx:TrnDefaultWebForm.dkt"

		
	#End

}
