<layout type="Web">
	<view>
		<responsive name="Main" class="ContainerFluid PromptContainer">
			<row>
				<cell class="PromptAdvancedBarCell" widthSm="25">
					<responsive name="AdvancedContainer" class="AdvancedContainerVisible">
						<row>
							<cell widthSm="100">
								<responsive name="AuthorIdFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblAuthorIdFilter" caption="=AuthorId.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cAuthorId" name="ctlcAuthorId" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="AuthorNameFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblAuthorNameFilter" caption="=AuthorName.Title" class="WWAdvancedLabel WWFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" data="&amp;cAuthorName" name="ctlcAuthorName" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<responsive name="AuthorBirthDateFilterContainer" class="AdvancedContainerItem AdvancedContainerItemExpanded">
									<row>
										<cell widthSm="100">
											<label name="LblAuthorBirthDateFilter" caption="=AuthorBirthDate.Title" class="WWAdvancedLabel WWDateFilterLabel" gxFormat="HTML" />
										</cell>
									</row>
									<row>
										<cell class="WWFiltersCell" widthSm="100">
											<input labelPosition="None" flatDatepicker="True" data="&amp;cAuthorBirthDate" name="ctlcAuthorBirthDate" />
										</cell>
									</row>
								</responsive>
							</cell>
						</row>
					</responsive>
				</cell>
				<cell class="WWGridCell" widthSm="75">
					<responsive name="GridTable">
						<row>
							<cell class="ToggleCell" visibleSm="False" widthXs="100" visibleMd="False" visibleLg="False">
								<action name="BtnToggle" onClickEvent="'Toggle'" caption="|||" class="BtnToggle" />
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<tabularGrid name="Grid1" class="PromptGrid" maxRows="10">
									<input title="" class="SelectionAttribute" columnClass="WWActionColumn" returnOnClick="True" data="&amp;LinkSelection" name="ctlLinkSelection" />
									<input title="=AuthorId.ContextualTitle" columnClass="WWColumn" data="AuthorId" name="ctlAuthorId" />
									<input title="=AuthorName.ContextualTitle" class="DescriptionAttribute" columnClass="WWColumn" returnOnClick="True" readOnly="True" data="AuthorName" name="ctlAuthorName" />
									<input title="=AuthorBirthDate.ContextualTitle" columnClass="WWColumn OptionalColumn" data="AuthorBirthDate" name="ctlAuthorBirthDate" />
								</tabularGrid>
							</cell>
						</row>
						<row>
							<cell widthSm="100">
								<action name="btn_cancel" onClickEvent="Cancel" caption="GX_BtnCancel" class="BtnCancel" />
							</cell>
						</row>
					</responsive>
				</cell>
			</row>
		</responsive>
	</view>
</layout>