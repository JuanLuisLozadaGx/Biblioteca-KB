								Description = 'Author Id',

								Autolink = 'True',

								Visible = 'True'

							]

							Attribute

							[

								Attribute = 'AuthorName',

								Description = 'Author Name',

								Autolink = 'True',

								Visible = 'True'

							]

							Attribute

							[

								Attribute = 'PublisherId',

								Description = 'Publisher Id',

								Autolink = 'True',

								Visible = 'True'

							]

							Attribute

							[

								Attribute = 'PublisherName',

								Description = 'Publisher Name',

								Autolink = 'True',

