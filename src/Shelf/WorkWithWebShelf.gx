				{

					Attributes

					{

						Attribute

						[

							Attribute = 'ShelfName',

							Description = 'Name',

							Autolink = 'True',

							Visible = 'True'

						]

					}

				}

				Tabs

				{

					Tab

					[

						Caption = 'General',

						Code = 'General',

						Description = 'Shelf Info',

						Type = 'Tabular',

						ComponentName = 'ShelfGeneral'

					]

					{

						Attributes

						{

							Attribute

							[

								Attribute = 'ShelfId',

								Description = 'Id',

								Autolink = 'True',

								Visible = 'True'

							]

							Attribute

							[

								Attribute = 'ShelfName',

								Description = 'Name',

								Autolink = 'True',

								Visible = 'True'

							]

							Attribute

							[

								Attribute = 'ShelfDescription',

								Description = 'Description',

								Autolink = 'True',

								Visible = 'True'

							]

						}

						Actions

						{

							Action

							[

								Name = 'Update'

							]

							Action

							[

								Name = 'Delete'

							]

						}

					}

					Tab

					[

						Caption = 'Book',

						Code = 'Book',

						Type = 'Grid',

						ComponentName = 'ShelfBookWC',

						RowsPerPage = '<default>'

					]

					{

						Transaction

						[

							Transaction = 'Book'

						]

						Modes

						Attributes

						{

							Attribute

							[

								Attribute = 'BookId',

								Description = 'Id',

