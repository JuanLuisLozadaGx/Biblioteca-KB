WorkWith WorkWithWebShelf
{
	WorkWithPatternInstance

	[

		UpdateTransaction = 'Apply WW Style'

	]

	{

		Transaction

		[

			Transaction = 'Shelf'

		]

		Level

		[

			Id = 'fe2bc639-fda8-42e0-9749-aceac9689a68:1',

			Name = 'Shelf'

		]

		{

			DescriptionAttribute

			[

				Attribute = 'ShelfName',

				Description = 'Name'

			]

			Selection

			[

				Description = 'Shelves',

				RowsPerPage = '<default>'

			]

			{

				Attributes

				{

					Attribute

					[

						Attribute = 'ShelfId',

						Description = 'Id',

						Autolink = 'True',

						Visible = 'True'

					]

					Attribute

					[

						Attribute = 'ShelfName',

						Description = 'Name',

						Autolink = 'True',

						Visible = 'True'

					]

					Attribute

					[

						Attribute = 'ShelfDescription',

						Description = 'Description',

						Autolink = 'True',

						Visible = 'True'

					]

				}

				Orders

				{

					Order

					[

						Name = 'Name'

					]

					{

						Attribute

						[

							Attribute = 'ShelfName',

							Description = 'Name',

							Ascending = 'True'

						]

					}

				}

				Filter

				{

					Attributes

					{

						FilterAttribute

						[

							Name = 'ShelfName',

							Description = 'Name',

							Default = ''

						]

					}

					Conditions

					{

						Condition

						[

							Value = 'ShelfName >= &ShelfName when not &ShelfName.IsEmpty()'

						]

					}

				}

			}

			View

			[

				Caption = 'ShelfName.ToString()',

				Description = 'Shelf Information',

				BackToSelection = 'True',

				MasterPage = '<default>'

			]

			{

				Parameters

				{

					Parameter

					[

						Name = 'ShelfId',

						NullValue = 'True'

					]

				}

